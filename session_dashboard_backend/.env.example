# ============================================================================
# Session Analytics Dashboard Backend - Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in actual values
# NEVER commit .env file with real credentials to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Option 1: Using Docker Compose PostgreSQL (recommended for development)
DATABASE_URL=postgresql://session_user:session_password@localhost:5432/session_analytics

# Option 2: Using external PostgreSQL
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# For production with SSL:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require

# ----------------------------------------------------------------------------
# Docker Compose PostgreSQL Configuration (if using Docker Compose)
# ----------------------------------------------------------------------------
POSTGRES_USER=session_user
POSTGRES_PASSWORD=session_password
POSTGRES_DB=session_analytics
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# pgAdmin Configuration (optional, for database management UI)
# ----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@kavia.ai
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ----------------------------------------------------------------------------
# JWT Configuration
# ----------------------------------------------------------------------------
# IMPORTANT: Generate strong secrets for production
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Frontend URL for CORS
CORS_ORIGIN=http://localhost:3000

# For production, use actual frontend URL:
# CORS_ORIGIN=https://analytics.kavia.ai

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# GxP Compliance Settings
# ----------------------------------------------------------------------------
# Audit trail retention (days)
AUDIT_RETENTION_DAYS=2555

# Session timeout (minutes)
SESSION_TIMEOUT_MINUTES=60

# Maximum failed login attempts before account lock
MAX_FAILED_LOGIN_ATTEMPTS=5

# Account lockout duration (minutes)
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# ----------------------------------------------------------------------------
# Export Configuration
# ----------------------------------------------------------------------------
# Directory for temporary export files
EXPORT_TEMP_DIR=/tmp/exports

# Maximum export file size (bytes) - 100MB default
MAX_EXPORT_SIZE_BYTES=104857600

# Export file retention (hours)
EXPORT_FILE_RETENTION_HOURS=24

# ----------------------------------------------------------------------------
# Email Configuration (optional, for notifications)
# ----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@kavia.ai

# ----------------------------------------------------------------------------
# Production Security Settings
# ----------------------------------------------------------------------------
# Enable HTTPS redirect in production
# FORCE_HTTPS=true

# Enable secure cookies in production
# SECURE_COOKIES=true

# Enable HSTS (HTTP Strict Transport Security)
# HSTS_ENABLED=true

# ----------------------------------------------------------------------------
# Monitoring (optional)
# ----------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# NEW_RELIC_LICENSE_KEY=your-new-relic-key
# NEW_RELIC_APP_NAME=session-analytics-backend

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production:
# [ ] Change all default passwords and secrets
# [ ] Use strong JWT_SECRET (32+ characters, random)
# [ ] Enable SSL for database connections
# [ ] Set NODE_ENV=production
# [ ] Configure proper CORS_ORIGIN
# [ ] Enable HTTPS and secure cookies
# [ ] Set up database backups
# [ ] Configure monitoring and alerting
# [ ] Review and adjust rate limits
# [ ] Set up log aggregation
# [ ] Enable audit trail monitoring
# ============================================================================

# NOTE: User must provide actual values for:
# - DATABASE_URL (or Docker Compose credentials)
# - JWT_SECRET and JWT_REFRESH_SECRET
# - CORS_ORIGIN (frontend URL)
