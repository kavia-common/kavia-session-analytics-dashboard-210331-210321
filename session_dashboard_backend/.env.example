# ============================================================================
# Session Analytics Dashboard Backend - Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in actual values
# NEVER commit .env file with real credentials to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# IMPORTANT: When using Docker Compose, the service name 'postgres' is used in DATABASE_URL
# For Docker Compose: postgresql://session_user:session_password@postgres:5432/session_analytics
# For local development: postgresql://session_user:session_password@localhost:5432/session_analytics
# User must provide DATABASE_URL
DATABASE_URL=postgresql://session_user:session_password@postgres:5432/session_analytics

# ----------------------------------------------------------------------------
# Docker Compose PostgreSQL Configuration
# ----------------------------------------------------------------------------
POSTGRES_USER=session_user
POSTGRES_PASSWORD=session_password
POSTGRES_DB=session_analytics
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# JWT Configuration
# ----------------------------------------------------------------------------
# IMPORTANT: User must provide strong secrets for production
# Generate using: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Frontend URL for CORS - User must configure for production
CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------------------------------
# GxP Compliance Settings
# ----------------------------------------------------------------------------
AUDIT_RETENTION_DAYS=2555
SESSION_TIMEOUT_MINUTES=60
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# ============================================================================
# REQUIRED USER-PROVIDED VALUES:
# ============================================================================
# - DATABASE_URL: Connection string for PostgreSQL
# - JWT_SECRET: Strong secret for JWT signing (32+ characters)
# - JWT_REFRESH_SECRET: Strong secret for refresh tokens (32+ characters)
# - CORS_ORIGIN: Frontend URL for production deployment
# - NODE_ENV: Set to 'production' for production deployment
# ============================================================================
