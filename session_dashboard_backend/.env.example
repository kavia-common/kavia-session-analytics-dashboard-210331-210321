# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# IMPORTANT: User must provide actual DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/session_analytics

# JWT Configuration
# IMPORTANT: User must provide secure JWT_SECRET
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRY=1h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# NOTE: This is a template file. Copy to .env and fill in actual values.
# NEVER commit .env file with real credentials to version control.
