{
  "name": "session-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend API for Kavia Session Analytics Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "migrate": "node src/migrations/runMigrations.js",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose stop postgres",
    "db:restart": "docker-compose restart postgres",
    "db:logs": "docker-compose logs -f postgres",
    "db:shell": "docker-compose exec postgres psql -U session_user -d session_analytics",
    "db:backup": "docker-compose exec postgres pg_dump -U session_user session_analytics > backup_$(date +%Y%m%d_%H%M%S).sql",
    "db:reset": "docker-compose down -v && docker-compose up -d postgres && npm run migrate",
    "db:validate": "node scripts/validate-database-setup.js",
    "db:status": "node scripts/show-database-status.js",
    "db:test-e2e": "bash scripts/test-database-e2e.sh",
    "pgadmin:start": "docker-compose up -d pgadmin",
    "pgadmin:stop": "docker-compose stop pgadmin"
  },
  "keywords": [
    "analytics",
    "dashboard",
    "gxp",
    "api"
  ],
  "author": "Kavia",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "pg": "^8.11.3",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
