# ============================================================================
# Session Analytics Dashboard Frontend - Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in actual values
# ============================================================================

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
# Backend API base URL - User must configure for deployment
# For Docker Compose: http://localhost:5000/api
# For production: https://your-backend-domain.com/api
REACT_APP_API_BASE_URL=http://localhost:5000/api

# ----------------------------------------------------------------------------
# Site URL Configuration
# ----------------------------------------------------------------------------
# Used for authentication redirects (e.g., email verification, OAuth callbacks)
# For local development: http://localhost:3000
# For production: https://your-frontend-domain.com
REACT_APP_SITE_URL=http://localhost:3000

# ============================================================================
# REQUIRED USER-PROVIDED VALUES:
# ============================================================================
# - REACT_APP_API_BASE_URL: Backend API endpoint
# - REACT_APP_SITE_URL: Frontend application URL for redirects
# ============================================================================
