# API Configuration
# The base URL for the backend API
# IMPORTANT: This environment variable must be set for the application to connect to the backend
# Example: http://localhost:5000/api or https://api.yourdomain.com
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Site URL for email redirects (used by Supabase or similar auth services)
REACT_APP_SITE_URL=http://localhost:3000
