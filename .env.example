# ============================================================================
# Kavia Session Analytics Dashboard - Root Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in actual values
# This file is used by docker-compose.yml
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_USER=session_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=session_analytics
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# Backend Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=5000

# JWT Configuration
# IMPORTANT: Generate strong secrets using: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_refresh_secret_min_32_characters_here
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------------------------------
# Frontend Configuration
# ----------------------------------------------------------------------------
FRONTEND_PORT=3000
REACT_APP_API_BASE_URL=http://localhost:5000/api
REACT_APP_SITE_URL=http://localhost:3000

# ============================================================================
# REQUIRED USER-PROVIDED VALUES FOR PRODUCTION:
# ============================================================================
# - POSTGRES_PASSWORD: Strong password for database (min 16 characters)
# - JWT_SECRET: Strong secret for JWT signing (min 32 characters)
# - JWT_REFRESH_SECRET: Strong secret for refresh tokens (min 32 characters)
# - CORS_ORIGIN: Frontend URL for production deployment
# - REACT_APP_API_BASE_URL: Backend API URL for production
# - REACT_APP_SITE_URL: Frontend URL for production
# ============================================================================

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST:
# ============================================================================
# [ ] Generate strong secrets (use: openssl rand -base64 32)
# [ ] Set NODE_ENV=production
# [ ] Use HTTPS URLs for CORS_ORIGIN and API base URL
# [ ] Configure SSL for database connection
# [ ] Set secure POSTGRES_PASSWORD
# [ ] Update REACT_APP_SITE_URL to production domain
# [ ] Update REACT_APP_API_BASE_URL to production API domain
# ============================================================================
